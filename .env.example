# Copy this file to .env and fill in your own values:
#
#     cp .env.example .env
#
# .env is git-ignored. Never commit real keys.

# Required. Groq API key — used by ChatGroq (model: openai/gpt-oss-20b).
# Create one at https://console.groq.com/keys
GROQ_API_KEY=

# Optional. Hugging Face API token.
# Not needed for the default setup: the embedding model
# (sentence-transformers/all-MiniLM-L6-v2) runs locally on CPU.
# Only required if you switch to a gated or private HF model.
# https://huggingface.co/settings/tokens
Hugging_face_api=
